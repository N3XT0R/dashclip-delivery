<?php

namespace Deployer;

require 'deploy_laravel_config.php';

// Project
set('application', 'dashclip-delivery');

// YOUR github PAT in clear text
set('GITHUB_PAT', '');

// Repository with PAT in the URL
set('repository', sprintf(
    'https://%s@github.com/N3XT0R/video_sharing.git',
    get('GITHUB_PAT')
));

set('branch', 'master');
set('git_tty', true);
set('keep_releases', 5);
set('allow_anonymous_stats', false);

// Laravel specifics
add('shared_files', ['.env']);
add('shared_dirs', ['storage']);
add('writable_dirs', ['storage', 'bootstrap/cache', 'storage/app/public/uploads/tmp']);
set('writable_mode', 'chmod');
set('writable_chmod_mode', '0775');
set('writable_chmod_recursive', true);
set('http_user', 'www-data');
set('http_group', 'www-data');
set('git_tty', false);
set('ssh_type', 'native');

// Hosts
host('prd')
    ->setHostname('example.tld')
    ->set('php_version', '8.5')
    ->setRemoteUser('root')
    ->set('deploy_path', '/var/www/dashclip')
    ->set('ssh_arguments', ['-o AddressFamily=inet6', '-o ConnectTimeout=30'])
    ->set('systemd', [
            'units' => ['php8.5-fpm', 'laravel-reverb'],
            'action' => 'restart',
            'sudo' => true,
        ])
    ->setSshMultiplexing(false);

// Hooks
after('deploy:failed', 'deploy:unlock');
after('deploy:cleanup', 'artisan:up');
// Passport encryption keys live in the shared storage dir and must persist across
// releases. 'artisan:passport:keys' skips itself when a key is already present, so a
// later deploy never regenerates them and previously issued tokens stay valid.
after('deploy:vendors', 'artisan:passport:keys');
// The recursive writable chmod sets every file in storage to 0775, including the Passport
// keys. The OAuth server warns on every token request unless they are 600/660, so the keys
// are reset afterwards and stay readable for the web server group.
task('passport:keys:permissions', static function () {
    run('chown {{http_user}}:{{http_group}} {{release_path}}/storage/oauth-*.key');
    run('chmod 660 {{release_path}}/storage/oauth-*.key');
})->desc('Restrict the Passport key file permissions');
after('artisan:passport:keys', 'passport:keys:permissions');
// The specs are versioned, but a deploy replaces the whole storage directory with a
// symlink to shared storage, so the committed copies never reach the running app.
// They must be regenerated on every deploy. --all covers every documentation in
// config/l5-swagger.php, currently authentication, submitter and channel-operator.
after('deploy:vendors', 'artisan:l5-swagger:generate');
